{
  "name": "media-ffmpeg-service",
  "version": "1.0.0",
  "description": "API REST para procesamiento multimedia asíncrono con FFmpeg, GridFS y BullMQ.",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "node --env-file .env src/main.js",
    "dev": "node --env-file .env.development --watch src/main.js",
    "lint": "eslint . --cache --cache-location .cache/eslint/",
    "lint:watch": "node --watch --watch-path=src --watch-path=config --watch-path=eslint.config.js ./node_modules/eslint/bin/eslint.js . --cache --cache-location .cache/eslint/",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "check": "npm run lint && npm test",
    "build": "node scripts/build.js",
    "build:protected": "node scripts/build.js --obfuscate",
    "start:dist": "node dist/app.js"
  },
  "dependencies": {
    "bullmq": "5.77.6",
    "express": "5.2.1",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "helmet": "8.2.0",
    "ioredis": "5.11.0",
    "mime-types": "3.0.2",
    "mongodb": "7.2.0",
    "mongoose": "9.6.3",
    "multer": "2.1.1",
    "nanoid": "5.1.11",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/eslint-plugin": "1.6.18",
    "esbuild": "0.28.0",
    "eslint": "10.4.1",
    "eslint-plugin-import-x": "4.16.2",
    "globals": "17.6.0",
    "javascript-obfuscator": "5.4.3",
    "terser": "5.48.0",
    "vitest": "4.1.7"
  }
}